<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppThemeBase" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="toolbarStyle">@style/NativeScriptToolbarStyle</item>
    <item name="colorPrimary">#147d92</item>
    <item name="colorPrimaryDark">#123c50</item>
    <item name="colorAccent">#147d92</item>
  </style>

  <style name="AppTheme" parent="AppThemeBase">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:navigationBarColor">#123c50</item>
    <item name="android:statusBarColor">#123c50</item>
  </style>

  <style name="NativeScriptToolbarStyleBase" parent="Widget.AppCompat.Toolbar">
    <item name="android:background">#147d92</item>
    <item name="theme">@style/ThemeOverlay.AppCompat.ActionBar</item>
    <item name="popupTheme">@style/ThemeOverlay.AppCompat</item>
  </style>

  <style name="NativeScriptToolbarStyle" parent="NativeScriptToolbarStyleBase" />
</resources>
