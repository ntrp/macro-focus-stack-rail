<Page navigatingTo="onNavigatingTo" class="page">
  <ActionBar title="Focus Rail" />

  <ScrollView>
    <StackLayout class="content">
      <GridLayout columns="*, auto" class="card connection-card">
        <StackLayout col="0">
          <Label text="{{ connectionLabel }}" class="connection-title" />
          <Label text="{{ detailLabel }}" textWrap="true" class="muted" />
        </StackLayout>
        <Button col="1" text="{{ connectButtonLabel }}" tap="{{ toggleConnection }}"
                isEnabled="{{ !busy }}" class="button secondary" />
      </GridLayout>

      <StackLayout class="card position-card">
        <Label text="Position" class="eyebrow" />
        <Label text="{{ positionLabel }}" class="position" />
        <GridLayout columns="*, *" rows="auto" class="status-grid">
          <Label col="0" text="{{ stateLabel }}" class="pill" />
          <Label col="1" text="{{ homedLabel }}" class="pill" />
        </GridLayout>
        <Label text="{{ errorLabel }}" visibility="{{ hasError ? 'visible' : 'collapse' }}"
               textWrap="true" class="error" />
      </StackLayout>

      <Button text="Home rail" tap="{{ home }}" isEnabled="{{ controlsEnabled }}"
              class="button primary home-button" />

      <StackLayout class="card">
        <Label text="Move relative" class="section-title" />
        <Label text="Distance in millimetres" class="muted" />
        <TextField text="{{ moveDistance }}" keyboardType="number" hint="1.0"
                   class="distance-input" />
        <GridLayout columns="*, *" class="button-row">
          <Button col="0" text="Move -" tap="{{ moveNegative }}"
                  isEnabled="{{ controlsEnabled }}" class="button secondary left-button" />
          <Button col="1" text="Move +" tap="{{ movePositive }}"
                  isEnabled="{{ controlsEnabled }}" class="button secondary right-button" />
        </GridLayout>
      </StackLayout>

      <StackLayout class="card">
        <Label text="Fine jog" class="section-title" />
        <Label text="Jog distance in millimetres" class="muted" />
        <TextField text="{{ jogDistance }}" keyboardType="number" hint="0.1"
                   class="distance-input" />
        <GridLayout columns="*, *" class="button-row">
          <Button col="0" text="Jog -" tap="{{ jogNegative }}"
                  isEnabled="{{ controlsEnabled }}" class="button secondary left-button" />
          <Button col="1" text="Jog +" tap="{{ jogPositive }}"
                  isEnabled="{{ controlsEnabled }}" class="button secondary right-button" />
        </GridLayout>
      </StackLayout>

      <Button text="Stop" tap="{{ stop }}" isEnabled="{{ connected }}"
              class="button stop-button" />
      <Label text="Position is open-loop. Home again after a stall, skipped step, or power loss."
             textWrap="true" class="footnote" />
    </StackLayout>
  </ScrollView>
</Page>

