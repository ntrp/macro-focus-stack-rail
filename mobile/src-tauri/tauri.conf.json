{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Rail",
  "version": "0.2.0",
  "identifier": "com.focusrail.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Focus Rail",
        "width": 420,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "infoPlist": "Info.macos.plist"
    },
    "iOS": {
      "minimumSystemVersion": "14.0",
      "frameworks": ["CoreBluetooth"],
      "infoPlist": "Info.ios.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
